{
  "name": "updateCategoryAdvanced",
  "displayName": "Update category",
  "type": "function",
  "crudMode": "update",
  "flags": [
    "mutable",
    "safe",
    "unthrottable"
  ],
  "usage": "advanced",
  "availableFor": [
    "API",
    "form"
  ],
  "alternatives": [
    {
      "operationName": "updateCategory",
      "label": "Basic"
    }
  ],
  "context": {
    "functionName": "updateCategoryAdvanced",
    "hosts": [
      "controlBackground",
      "headlessSdk"
    ]
  },
  "description": "Changes a category's name, icon or subcategory order, using the category's id.",
  "parameters": {
    "categoryId": {
      "type": "string",
      "displayName": "Category id",
      "required": true,
      "description": "The category's id, as shown in search results.",
      "sampleValue": "[category id]"
    },
    "newName": {
      "type": "string",
      "displayName": "New name",
      "required": false,
      "description": "The category's new name. Leave it out to keep the current one.",
      "sampleValue": "[new category name]"
    },
    "newIcon": {
      "type": "image",
      "displayName": "New icon",
      "required": false,
      "description": "A new picture or icon for the category, as a list holding one. Leave it out to keep the current one, or pass an empty list to remove it.",
      "minValue": 0,
      "maxValue": 1,
      "nullable": true,
      "sampleValue": [
        "[image url]"
      ]
    },
    "newSubcategorySortOrder": {
      "type": "select",
      "displayName": "New subcategory order",
      "required": false,
      "description": "How its subcategories are ordered; changing it sorts them again. Leave it out to keep the current order.",
      "enums": [
        {
          "label": "Manual",
          "value": "Manually"
        },
        {
          "label": "Subcategory Title A-Z",
          "value": "Subcategory Title A-Z"
        },
        {
          "label": "Subcategory Title Z-A",
          "value": "Subcategory Title Z-A"
        },
        {
          "label": "Subcategory Date Asc",
          "value": "Subcategory Date Asc"
        },
        {
          "label": "Subcategory Date Desc",
          "value": "Subcategory Date Desc"
        },
        {
          "label": "Newest",
          "value": "Newest"
        },
        {
          "label": "Oldest",
          "value": "Oldest"
        }
      ],
      "allowEnumCustomOption": false,
      "sampleValue": "Manually"
    },
    "callback": {
      "type": "function",
      "required": true,
      "description": "Runs when the category is changed.",
      "parameters": {
        "error": {
          "type": "object|string",
          "description": "Why it wasn't changed, such as no category having that id."
        },
        "result": {
          "type": "object",
          "description": "The category as it now stands.",
          "properties": {
            "id": {
              "type": "string",
              "description": "The category's id."
            },
            "name": {
              "type": "string",
              "description": "The category's name."
            },
            "icon": {
              "type": "string",
              "description": "Its picture or icon."
            },
            "subcategorySortOrder": {
              "type": "string",
              "description": "How its subcategories are ordered."
            },
            "rank": {
              "type": "number",
              "description": "Its place in the manual order."
            },
            "createdOn": {
              "type": "datetime",
              "description": "When it was added."
            },
            "lastUpdatedOn": {
              "type": "datetime",
              "description": "When it was last changed."
            },
            "subcategories": {
              "type": "array",
              "description": "Its subcategories, in order.",
              "items": {
                "type": "object",
                "description": "One subcategory.",
                "properties": {
                  "id": {
                    "type": "string",
                    "description": "The subcategory's id."
                  },
                  "name": {
                    "type": "string",
                    "description": "The subcategory's name."
                  },
                  "rank": {
                    "type": "number",
                    "description": "Its place in the list."
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
