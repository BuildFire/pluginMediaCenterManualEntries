          "properties": {
            "id": {
              "type": "string",
              "description": "The media item's id."
            },
            "title": {
              "type": "string",
              "description": "The item's title."
            },
            "deleted": {
              "type": "boolean",
              "description": "Whether the media item was deleted."
            }
          }
