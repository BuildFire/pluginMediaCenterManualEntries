{
  "name": "updateSubcategoryAdvanced",
  "displayName": "Rename subcategory",
  "type": "function",
  "crudMode": "update",
  "flags": [
    "mutable",
    "safe",
    "unthrottable"
  ],
  "usage": "advanced",
  "alternatives": [
    {
      "operationName": "updateSubcategory",
      "label": "Basic"
    }
  ],
  "availableFor": [
    "API",
    "form"
  ],
  "context": {
    "functionName": "updateSubcategoryAdvanced",
    "hosts": [
      "controlBackground",
      "headlessSdk"
    ]
  },
  "description": "Renames a subcategory, using its id and its category's id.",
  "parameters": {
    "categoryId": {
      "type": "string",
      "displayName": "Category id",
      "required": true,
      "description": "The id of the category it is in, as shown in search results.",
      "sampleValue": "[category id]"
    },
    "subcategoryId": {
      "type": "string",
      "displayName": "Subcategory id",
      "required": true,
      "description": "The subcategory's id, as shown in search results.",
      "sampleValue": "[subcategory id]"
    },
    "newName": {
      "type": "string",
      "displayName": "New name",
      "required": true,
      "description": "The subcategory's new name.",
      "sampleValue": "[new subcategory name]"
    },
    "callback": {
      "type": "function",
      "required": true,
      "description": "Runs when the subcategory is renamed.",
      "parameters": {
        "error": {
          "type": "object|string",
          "description": "Why it wasn't renamed, such as an unknown subcategory."
        },
        "result": {
          "type": "object",
          "description": "The renamed subcategory.",
          "properties": {
            "categoryId": {
              "type": "string",
              "description": "The id of the category it belongs to."
            },
            "id": {
              "type": "string",
              "description": "The subcategory's id."
            },
            "name": {
              "type": "string",
              "description": "The subcategory's name."
            },
            "rank": {
              "type": "number",
              "description": "Its place in the manual order."
            }
          }
        }
      }
    }
  }
}
