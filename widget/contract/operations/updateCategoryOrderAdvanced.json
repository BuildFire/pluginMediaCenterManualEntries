{
  "name": "updateCategoryOrderAdvanced",
  "displayName": "Move category",
  "type": "function",
  "crudMode": "update",
  "flags": [
    "mutable",
    "safe",
    "throttable"
  ],
  "usage": "advanced",
  "availableFor": [
    "API",
    "form"
  ],
  "alternatives": [
    {
      "operationName": "updateCategoryOrder",
      "label": "Basic"
    }
  ],
  "context": {
    "functionName": "updateCategoryOrderAdvanced",
    "hosts": [
      "controlBackground",
      "headlessSdk"
    ]
  },
  "description": "Moves a category to another place in the manual order, using the category's id.",
  "parameters": {
    "categoryId": {
      "type": "string",
      "displayName": "Category id",
      "required": true,
      "description": "The category's id, as shown in search results.",
      "sampleValue": "[category id]"
    },
    "position": {
      "type": "number",
      "displayName": "New position",
      "required": true,
      "description": "Where to move it in the manual order, counting from 1 for the first place.",
      "minValue": 1,
      "sampleValue": 1
    },
    "callback": {
      "type": "function",
      "required": true,
      "description": "Runs when the category is moved.",
      "parameters": {
        "error": {
          "type": "object|string",
          "description": "Why it wasn't moved, such as no category having that id or a place past the end of the list."
        },
        "result": {
          "type": "object",
          "description": "The category as it now stands.",
          "properties": {
            "id": {
              "type": "string",
              "description": "The category's id."
            },
            "name": {
              "type": "string",
              "description": "The category's name."
            },
            "icon": {
              "type": "string",
              "description": "Its picture or icon."
            },
            "subcategorySortOrder": {
              "type": "string",
              "description": "How its subcategories are ordered."
            },
            "rank": {
              "type": "number",
              "description": "Its place in the manual order."
            },
            "createdOn": {
              "type": "datetime",
              "description": "When it was added."
            },
            "lastUpdatedOn": {
              "type": "datetime",
              "description": "When it was last changed."
            },
            "subcategories": {
              "type": "array",
              "description": "Its subcategories, in order.",
              "items": {
                "type": "object",
                "description": "One subcategory.",
                "properties": {
                  "id": {
                    "type": "string",
                    "description": "The subcategory's id."
                  },
                  "name": {
                    "type": "string",
                    "description": "The subcategory's name."
                  },
                  "rank": {
                    "type": "number",
                    "description": "Its place in the list."
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
