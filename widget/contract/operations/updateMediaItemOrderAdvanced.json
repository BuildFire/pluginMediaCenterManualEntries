{
  "name": "updateMediaItemOrderAdvanced",
  "displayName": "Move media item",
  "type": "function",
  "crudMode": "update",
  "flags": [
    "mutable",
    "safe",
    "throttable"
  ],
  "usage": "advanced",
  "availableFor": [
    "API",
    "form"
  ],
  "alternatives": [
    {
      "operationName": "updateMediaItemOrder",
      "label": "Basic"
    }
  ],
  "context": {
    "functionName": "updateMediaItemOrderAdvanced",
    "hosts": [
      "controlBackground",
      "headlessSdk"
    ]
  },
  "description": "Moves a media item to another place in the manual order, using the item's id.",
  "parameters": {
    "mediaItemId": {
      "type": "string",
      "displayName": "Media item id",
      "required": true,
      "description": "The media item's id, as shown in search results.",
      "sampleValue": "[media item id]"
    },
    "position": {
      "type": "number",
      "displayName": "New position",
      "required": true,
      "description": "Where to move it in the manual order, counting from 1 for the first place.",
      "minValue": 1,
      "sampleValue": 1
    },
    "callback": {
      "type": "function",
      "required": true,
      "description": "Runs when the item is moved.",
      "parameters": {
        "error": {
          "type": "object|string",
          "description": "Why it wasn't moved, such as no item having that id or a place past the end of the list."
        },
        "result": {
          "type": "object",
          "description": "The media item as it now stands.",
          "properties": {
            "id": {
              "type": "string",
              "description": "The media item's id."
            },
            "title": {
              "type": "string",
              "description": "The item's title."
            },
            "summary": {
              "type": "string",
              "description": "The short text shown under its title."
            },
            "body": {
              "type": "string",
              "description": "The item's formatted content."
            },
            "sourceUrl": {
              "type": "string",
              "description": "The link to where the media comes from."
            },
            "videoUrl": {
              "type": "string",
              "description": "The link to its video."
            },
            "audioTitle": {
              "type": "string",
              "description": "The title shown in the audio player."
            },
            "artists": {
              "type": "string",
              "description": "The album artists shown in the audio player."
            },
            "audioUrl": {
              "type": "string",
              "description": "The link to its audio."
            },
            "thumbnailImage": {
              "type": "string",
              "description": "The picture shown in the list and on its page."
            },
            "audioImage": {
              "type": "string",
              "description": "The picture shown in the audio player."
            },
            "audioBackgroundImage": {
              "type": "string",
              "description": "The picture shown blurred behind the audio player."
            },
            "mediaDate": {
              "type": "datetime",
              "description": "The date shown for it."
            },
            "actionLinks": {
              "type": "array",
              "description": "The action buttons on its page, in order.",
              "items": {
                "type": "object",
                "description": "One action.",
                "properties": {
                  "title": {
                    "type": "string",
                    "description": "The button's text."
                  },
                  "action": {
                    "type": "string",
                    "description": "What the button does, such as opening a website."
                  }
                }
              }
            },
            "categoryIds": {
              "type": "array",
              "description": "The categories it is in.",
              "items": {
                "type": "string",
                "description": "A category's id."
              }
            },
            "subcategoryIds": {
              "type": "array",
              "description": "The subcategories it is in.",
              "items": {
                "type": "string",
                "description": "A subcategory's id."
              }
            },
            "rank": {
              "type": "number",
              "description": "Its place in the manual order."
            },
            "createdOn": {
              "type": "datetime",
              "description": "When it was added."
            },
            "deepLinkUrl": {
              "type": "string",
              "description": "The link that opens it in the app."
            }
          }
        }
      }
    }
  }
}
