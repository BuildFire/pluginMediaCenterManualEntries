{
  "name": "searchMediaItems",
  "displayName": "Search media items",
  "type": "function",
  "crudMode": "read",
  "flags": [
    "immutable",
    "safe",
    "unthrottable"
  ],
  "usage": "basic",
  "availableFor": [
    "API",
    "form"
  ],
  "context": {
    "functionName": "searchMediaItems",
    "hosts": [
      "widgetBackground",
      "controlBackground",
      "headlessSdk"
    ]
  },
  "description": "Shows the media items in the order the app lists them, optionally only those matching a title or in a category.",
  "parameters": {
    "title": {
      "type": "string",
      "displayName": "Title contains",
      "required": false,
      "description": "Only show items whose title contains this text. Leave it out to show every item.",
      "sampleValue": "[media title]"
    },
    "categoryName": {
      "type": "string",
      "displayName": "Category",
      "required": false,
      "description": "Only show items in the category with this name. Leave it out to show items of every category.",
      "sampleValue": "[category name]"
    },
    "subcategoryName": {
      "type": "string",
      "displayName": "Subcategory",
      "required": false,
      "description": "Only show items in the subcategory with this name, within the category given. Leave it out to show the whole category.",
      "sampleValue": "[subcategory name]"
    },
    "page": {
      "type": "number",
      "displayName": "Page",
      "required": false,
      "description": "Which page of results to show, starting at 0 for the first. Leave it out for the first page.",
      "minValue": 0,
      "sampleValue": 0
    },
    "pageSize": {
      "type": "number",
      "displayName": "Items per page",
      "required": false,
      "description": "How many items a page shows, up to 50. Leave it out for 20.",
      "minValue": 1,
      "maxValue": 50,
      "sampleValue": 20
    },
    "callback": {
      "type": "function",
      "required": true,
      "description": "Runs when the search is done.",
      "parameters": {
        "error": {
          "type": "object|string",
          "description": "Why it didn't work, such as no category having that name."
        },
        "result": {
          "type": "object",
          "description": "The media items that were found.",
          "properties": {
            "mediaItems": {
              "type": "array",
              "description": "The items on this page, in the order the app lists them.",
              "items": {
                "type": "object",
                "description": "One media item.",
                "properties": {
                  "id": {
                    "type": "string",
                    "description": "The media item's id."
                  },
                  "title": {
                    "type": "string",
                    "description": "The item's title."
                  },
                  "summary": {
                    "type": "string",
                    "description": "The short text shown under its title."
                  },
                  "body": {
                    "type": "string",
                    "description": "The item's formatted content."
                  },
                  "sourceUrl": {
                    "type": "string",
                    "description": "The link to where the media comes from."
                  },
                  "videoUrl": {
                    "type": "string",
                    "description": "The link to its video."
                  },
                  "audioTitle": {
                    "type": "string",
                    "description": "The title shown in the audio player."
                  },
                  "artists": {
                    "type": "string",
                    "description": "The album artists shown in the audio player."
                  },
                  "audioUrl": {
                    "type": "string",
                    "description": "The link to its audio."
                  },
                  "thumbnailImage": {
                    "type": "string",
                    "description": "The picture shown in the list and on its page."
                  },
                  "audioImage": {
                    "type": "string",
                    "description": "The picture shown in the audio player."
                  },
                  "audioBackgroundImage": {
                    "type": "string",
                    "description": "The picture shown blurred behind the audio player."
                  },
                  "mediaDate": {
                    "type": "datetime",
                    "description": "The date shown for it."
                  },
                  "actionLinks": {
                    "type": "array",
                    "description": "The action buttons on its page, in order.",
                    "items": {
                      "type": "object",
                      "description": "One action.",
                      "properties": {
                        "title": {
                          "type": "string",
                          "description": "The button's text."
                        },
                        "action": {
                          "type": "string",
                          "description": "What the button does, such as opening a website."
                        }
                      }
                    }
                  },
                  "categoryIds": {
                    "type": "array",
                    "description": "The categories it is in.",
                    "items": {
                      "type": "string",
                      "description": "A category's id."
                    }
                  },
                  "subcategoryIds": {
                    "type": "array",
                    "description": "The subcategories it is in.",
                    "items": {
                      "type": "string",
                      "description": "A subcategory's id."
                    }
                  },
                  "rank": {
                    "type": "number",
                    "description": "Its place in the manual order."
                  },
                  "createdOn": {
                    "type": "datetime",
                    "description": "When it was added."
                  },
                  "deepLinkUrl": {
                    "type": "string",
                    "description": "The link that opens it in the app."
                  }
                }
              }
            },
            "total": {
              "type": "number",
              "description": "How many items match in all."
            },
            "page": {
              "type": "number",
              "description": "The page shown."
            },
            "hasMore": {
              "type": "boolean",
              "description": "Whether another page follows."
            }
          }
        }
      }
    }
  }
}
