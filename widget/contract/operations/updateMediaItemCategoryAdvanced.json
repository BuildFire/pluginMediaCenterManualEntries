{
  "name": "updateMediaItemCategoryAdvanced",
  "displayName": "Update media item's category",
  "type": "function",
  "crudMode": "update",
  "flags": [
    "mutable",
    "safe",
    "unthrottable"
  ],
  "usage": "advanced",
  "availableFor": [
    "API",
    "form"
  ],
  "alternatives": [
    {
      "operationName": "updateMediaItemCategory",
      "label": "Basic"
    }
  ],
  "context": {
    "functionName": "updateMediaItemCategoryAdvanced",
    "hosts": [
      "controlBackground",
      "headlessSdk"
    ]
  },
  "description": "Puts a media item in a category or one of its subcategories, or takes it out, using their ids.",
  "parameters": {
    "mediaItemId": {
      "type": "string",
      "displayName": "Media item id",
      "required": true,
      "description": "The media item's id, as shown in search results.",
      "sampleValue": "[media item id]"
    },
    "categoryId": {
      "type": "string",
      "displayName": "Category id",
      "required": true,
      "description": "The category's id, as shown in search results.",
      "sampleValue": "[category id]"
    },
    "subcategoryId": {
      "type": "string",
      "displayName": "Subcategory id",
      "required": false,
      "description": "The id of a subcategory of that category, as shown with it in search results. Leave it out to put the item in, or take it out of, the whole category.",
      "sampleValue": "[subcategory id]"
    },
    "included": {
      "type": "boolean",
      "displayName": "In category",
      "required": true,
      "description": "Turn on to put the item in the category or subcategory, off to take it out.",
      "sampleValue": true
    },
    "callback": {
      "type": "function",
      "required": true,
      "description": "Runs when the item is changed.",
      "parameters": {
        "error": {
          "type": "object|string",
          "description": "Why it wasn't changed, such as no category having that id."
        },
        "result": {
          "type": "object",
          "description": "The media item as it now stands.",
          "properties": {
            "id": {
              "type": "string",
              "description": "The media item's id."
            },
            "title": {
              "type": "string",
              "description": "The item's title."
            },
            "summary": {
              "type": "string",
              "description": "The short text shown under its title."
            },
            "body": {
              "type": "string",
              "description": "The item's formatted content."
            },
            "sourceUrl": {
              "type": "string",
              "description": "The link to where the media comes from."
            },
            "videoUrl": {
              "type": "string",
              "description": "The link to its video."
            },
            "audioTitle": {
              "type": "string",
              "description": "The title shown in the audio player."
            },
            "artists": {
              "type": "string",
              "description": "The album artists shown in the audio player."
            },
            "audioUrl": {
              "type": "string",
              "description": "The link to its audio."
            },
            "thumbnailImage": {
              "type": "string",
              "description": "The picture shown in the list and on its page."
            },
            "audioImage": {
              "type": "string",
              "description": "The picture shown in the audio player."
            },
            "audioBackgroundImage": {
              "type": "string",
              "description": "The picture shown blurred behind the audio player."
            },
            "mediaDate": {
              "type": "datetime",
              "description": "The date shown for it."
            },
            "actionLinks": {
              "type": "array",
              "description": "The action buttons on its page, in order.",
              "items": {
                "type": "object",
                "description": "One action.",
                "properties": {
                  "title": {
                    "type": "string",
                    "description": "The button's text."
                  },
                  "action": {
                    "type": "string",
                    "description": "What the button does, such as opening a website."
                  }
                }
              }
            },
            "categoryIds": {
              "type": "array",
              "description": "The categories it is in.",
              "items": {
                "type": "string",
                "description": "A category's id."
              }
            },
            "subcategoryIds": {
              "type": "array",
              "description": "The subcategories it is in.",
              "items": {
                "type": "string",
                "description": "A subcategory's id."
              }
            },
            "rank": {
              "type": "number",
              "description": "Its place in the manual order."
            },
            "createdOn": {
              "type": "datetime",
              "description": "When it was added."
            },
            "deepLinkUrl": {
              "type": "string",
              "description": "The link that opens it in the app."
            }
          }
        }
      }
    }
  }
}
