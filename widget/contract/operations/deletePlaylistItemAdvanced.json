{
  "name": "deletePlaylistItemAdvanced",
  "displayName": "Remove from playlist",
  "type": "function",
  "crudMode": "delete",
  "flags": [
    "mutable",
    "safe",
    "unthrottable"
  ],
  "usage": "advanced",
  "alternatives": [
    {
      "operationName": "deletePlaylistItem",
      "label": "Basic"
    }
  ],
  "availableFor": [
    "API",
    "form"
  ],
  "context": {
    "functionName": "deletePlaylistItemAdvanced",
    "hosts": [
      "widgetBackground",
      "controlBackground",
      "headlessSdk"
    ]
  },
  "description": "Removes a media item from a person's playlist on behalf of the app, using the media item's id.",
  "parameters": {
    "userId": {
      "type": "user",
      "displayName": "User",
      "required": true,
      "description": "The person whose playlist it is, by their id or email address.",
      "sampleValue": "[user id]"
    },
    "mediaId": {
      "type": "string",
      "displayName": "Media id",
      "required": true,
      "description": "The media item's id, as shown in the playlist.",
      "sampleValue": "[media id]"
    },
    "callback": {
      "type": "function",
      "required": true,
      "description": "Runs when the item is removed.",
      "parameters": {
        "error": {
          "type": "object|string",
          "description": "Why it wasn't removed, such as the item not being in the playlist."
        },
        "result": {
          "type": "object",
          "description": "The removed item.",
          "properties": {
            "mediaId": {
              "type": "string",
              "description": "The media item's id."
            },
            "title": {
              "type": "string",
              "description": "The media item's title."
            }
          }
        }
      }
    }
  }
}
