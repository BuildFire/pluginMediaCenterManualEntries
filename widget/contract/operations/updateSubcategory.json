{
  "name": "updateSubcategory",
  "displayName": "Update subcategory",
  "type": "function",
  "crudMode": "update",
  "flags": [
    "mutable",
    "safe",
    "unthrottable"
  ],
  "usage": "basic",
  "availableFor": [
    "API",
    "form"
  ],
  "alternatives": [
    {
      "operationName": "updateSubcategoryAdvanced",
      "label": "Advanced"
    }
  ],
  "context": {
    "functionName": "updateSubcategory",
    "hosts": [
      "controlBackground",
      "headlessSdk"
    ]
  },
  "description": "Renames a subcategory, found by its name and its category's name.",
  "parameters": {
    "categoryName": {
      "type": "string",
      "displayName": "Category name",
      "required": true,
      "description": "The exact name of the category.",
      "sampleValue": "[category name]"
    },
    "subcategoryName": {
      "type": "string",
      "displayName": "Subcategory name",
      "required": true,
      "description": "The exact name of the subcategory, within that category.",
      "sampleValue": "[subcategory name]"
    },
    "newName": {
      "type": "string",
      "displayName": "New name",
      "required": true,
      "description": "The subcategory's new name.",
      "sampleValue": "[new subcategory name]"
    },
    "callback": {
      "type": "function",
      "required": true,
      "description": "Runs when the subcategory is renamed.",
      "parameters": {
        "error": {
          "type": "object|string",
          "description": "Why it wasn't renamed, such as no subcategory having that name."
        },
        "result": {
          "type": "object",
          "description": "The renamed subcategory.",
          "properties": {
            "id": {
              "type": "string",
              "description": "The subcategory's id."
            },
            "name": {
              "type": "string",
              "description": "The subcategory's name."
            },
            "rank": {
              "type": "number",
              "description": "Its place in the list."
            },
            "category": {
              "type": "object",
              "description": "The category it belongs to, as it now stands.",
              "properties": {
                "id": {
                  "type": "string",
                  "description": "The category's id."
                },
                "name": {
                  "type": "string",
                  "description": "The category's name."
                },
                "icon": {
                  "type": "string",
                  "description": "Its picture or icon."
                },
                "subcategorySortOrder": {
                  "type": "string",
                  "description": "How its subcategories are ordered."
                },
                "rank": {
                  "type": "number",
                  "description": "Its place in the manual order."
                },
                "createdOn": {
                  "type": "datetime",
                  "description": "When it was added."
                },
                "lastUpdatedOn": {
                  "type": "datetime",
                  "description": "When it was last changed."
                },
                "subcategories": {
                  "type": "array",
                  "description": "Its subcategories, in order.",
                  "items": {
                    "type": "object",
                    "description": "One subcategory.",
                    "properties": {
                      "id": {
                        "type": "string",
                        "description": "The subcategory's id."
                      },
                      "name": {
                        "type": "string",
                        "description": "The subcategory's name."
                      },
                      "rank": {
                        "type": "number",
                        "description": "Its place in the list."
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
