{
  "name": "deleteFavoritesAdvanced",
  "displayName": "Remove favorites",
  "type": "function",
  "crudMode": "delete",
  "flags": [
    "mutable",
    "dangerous",
    "throttable"
  ],
  "usage": "advanced",
  "availableFor": [
    "API"
  ],
  "context": {
    "functionName": "deleteFavoritesAdvanced",
    "hosts": [
      "widgetBackground"
    ]
  },
  "description": "Removes several media items from the favorites at once.",
  "parameters": {
    "favorites": {
      "type": "list",
      "displayName": "Favorites",
      "required": true,
      "minValue": 1,
      "maxValue": 50,
      "description": "The favorites to remove, up to 50 at a time.",
      "items": {
        "mediaId": {
          "type": "string",
          "displayName": "Media id",
          "required": true,
          "description": "The media item's id, as shown in the favorites.",
          "sampleValue": "[media id]"
        }
      },
      "sampleValue": [
        {
          "mediaId": "[media id]"
        }
      ]
    },
    "callback": {
      "type": "function",
      "required": true,
      "description": "Runs when all the favorites are done.",
      "parameters": {
        "error": {
          "type": "object|string",
          "description": "Why nothing was removed, such as an item that is not a favorite."
        },
        "result": {
          "type": "object",
          "description": "How each favorite went.",
          "properties": {
            "favorites": {
              "type": "array",
              "description": "One result per favorite, in the order they were given.",
              "items": {
                "type": "object",
                "description": "How one favorite went.",
                "properties": {
                  "index": {
                    "type": "number",
                    "description": "Which favorite this is, counting from 0."
                  },
                  "id": {
                    "type": "string",
                    "description": "The favorite's id, if it was removed."
                  },
                  "error": {
                    "type": "string",
                    "description": "Why it wasn't removed, if it wasn't."
                  }
                }
              }
            },
            "succeeded": {
              "type": "number",
              "description": "How many were removed."
            },
            "failed": {
              "type": "number",
              "description": "How many weren't removed."
            }
          }
        }
      }
    }
  }
}
